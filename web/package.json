{
  "name": "kaleidoscope",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "bench": "vitest run --config /dev/null bench",
    "profile": "esbuild bench/profile.ts --bundle --platform=node --format=esm --outfile=bench/.profile.mjs --log-level=warning && node --cpu-prof --cpu-prof-dir=bench/.profiles bench/.profile.mjs"
  },
  "devDependencies": {
    "@types/three": "^0.169.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "three": "^0.169.0"
  }
}
